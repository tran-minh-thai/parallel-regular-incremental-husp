# Shell scripts must keep LF endings; CRLF breaks bash on macOS/Linux.
*.sh        text eol=lf

# PowerShell is happy with either; keep CRLF on Windows checkouts.
*.ps1       text eol=crlf

# Java sources: let git normalize to LF in the index, native eol in the working tree.
*.java      text
*.xml       text
*.md        text
*.gitignore text
*.gitattributes text

# Python tools: LF everywhere, so their hashes match on Windows and macOS.
*.py        text eol=lf

# Measurement artifacts keep their bytes exactly as written.
results/9950x/** -text
