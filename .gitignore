# Compiled output
out/
target/
*.class
*.jar

# IDE files
.idea/
*.iml
*.iws
*.ipr
.vscode/

# OS metadata
.DS_Store
Thumbs.db

# Experiment outputs (generated, not versioned)
results/
test_output/
*.log

# Benchmark data lives in the huspm-datasets release, never in this repository. datasets/
# is the extraction target: pull the tarball into it, and everything landing there stays
# untracked. See RUNNING.md for the command and the checksum step.
datasets/*.txt
datasets/MANIFEST.sha256
datasets/*.tar.gz

# Exception: the four example files are TEST FIXTURES, not benchmark data. --test runs on
# them, they are a few KB, and they are deliberately absent from the release, so they are
# the one kind of data that belongs with the code.
!datasets/example_seq.txt
!datasets/example_eui.txt
!datasets/example2_seq.txt
!datasets/example2_eui.txt
